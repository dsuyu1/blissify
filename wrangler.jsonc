{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blissify",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "WorkshopRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "rooms-v1",
      "new_sqlite_classes": [
        "WorkshopRoom"
      ]
    }
  ]
}
